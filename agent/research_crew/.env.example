# PostgreSQL — same DB as the Next.js app (use Neon URL in production)
DATABASE_URL=postgres://postgres:password@localhost:5432/vectordb

# Groq — free LLM provider (https://console.groq.com → API Keys)
GROQ_API_KEY=gsk_...

# HuggingFace — free embeddings (https://huggingface.co/settings/tokens)
# Optional: if not set, logs are stored without vector embeddings
HF_API_KEY=hf_...
