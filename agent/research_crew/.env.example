# LLM provider — only ONE is needed at a time
# Currently configured to use Ollama (local, no quota).
# Swap OLLAMA_BASE_URL below if running on a different host.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Groq (fast, free tier available)
# GROQ_API_KEY=gsk_...

# Optional: Google Gemini
# GEMINI_API_KEY=AIza...

# PostgreSQL — same DB as the Next.js app
DATABASE_URL=postgres://postgres:password@localhost:5432/vectordb
